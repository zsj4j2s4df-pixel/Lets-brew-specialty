{
  "name": "letsbrewspecialty",
  "main": "site-worker.mjs",
  "compatibility_date": "2026-10-24",
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"430284716","simple":{"limit":10,"period":60}}],
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true}
}
